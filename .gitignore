# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
# env / secrets: .env and .env.tts are tracked but git-crypt encrypted (see README "API keys").
# The git-crypt key file itself must never be committed.
*.git-crypt.key
.env.local
# runtime data (sessions, sqlite, llm cache, recordings)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/sessions/
data/cache/
data/lectures/*/media.*
data/uploads/
data/demo-mode.json
# node
node_modules/
frontend/dist/
.vercel/
# arduino
firmware/**/build/
# os
.DS_Store
# mindwave pipeline session recordings (their default dir) and NeuroPace EEG logs
sessions/
data/eeg/
data/verification/trial-*/
data/verification/native-trial-*/
data/verification/guided-media-*/
data/verification/native-media-*/
data/verification/calibration-cues-*/
data/verification/personal-calibration-*/
data/verification/*.wav

# OpenAlex snapshot slices (scripts/build_jargon_table.py input; fetch.py layout). Never committed.
data/openalex/
data/scholar.db*
