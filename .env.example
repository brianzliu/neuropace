# Copy to .env and fill in. Everything runs without keys (simulated transcript + offline recaps),
# but the demo needs both for live transcription and generated cards.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_API_KEY=
NEUROPACE_TTS_MODEL=flux-cole-en
NEUROPACE_TTS_EXPRESSIVITY=2
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Which service generates explanations: openai, openrouter or gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUESTS_PER_MINUTE=5
NEUROPACE_LLM_PROVIDER=openai
OPENROUTER_MODEL=openai/gpt-4o-mini
# Small, fast model for the 20 s rolling-recap loop. `neuropace doctor` checks it exists.
OPENAI_MODEL=gpt-5-mini
# Serial ports. Leave empty to auto-detect (MindWave* / usbmodem*). Set to "sim" to force simulation.
NEUROPACE_HEADSET_PORT=
NEUROPACE_TOTEM_PORT=
# Baseline length in seconds (spec: 180). Use 30 for rehearsals.
NEUROPACE_BASELINE_SECONDS=180
# Where sqlite + session logs live
NEUROPACE_DATA_DIR=data
NEUROPACE_HOST=127.0.0.1
NEUROPACE_PORT=8765
